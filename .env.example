# ========================================================
# COIN CARET DEVELOPMENT ENVIRONMENT (.env)
# ========================================================

# Explicit IPv4 PostgreSQL connection (Port 5432)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/coin_caret_dev?schema=public"

# NextAuth Authentication
NEXTAUTH_SECRET="coin-caret-dev-secret-key-32-chars-minimum-length-12345"
NEXTAUTH_URL="http://127.0.0.1:3847"

# Local Server Dedicated Port
PORT=3847

# Network Engine Defaults
BLOCK_INTERVAL_MS=10000
STANDARD_FEE_CC=0.50
REQUIRED_CONFIRMATIONS=3

# Seed Platform Admin Credentials
ADMIN_SEED_EMAIL="admin@coincaret.com"
ADMIN_SEED_PASSWORD="AdminPassword123!"

# Node Environment
NODE_ENV="development"
