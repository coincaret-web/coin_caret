{
  "name": "coin_caret",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3847",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3847",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx dotenv-cli -e .env.test -- vitest run --dir src/tests/unit",
    "test:integration": "npx dotenv-cli -e .env.test -- vitest run --dir src/tests/integration",
    "test:e2e": "npx dotenv-cli -e .env.test -- playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "ci:quality": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "worker:dev": "npx dotenv-cli -e .env -- tsx watch src/worker/block-generator.ts",
    "worker:prod": "node dist/worker/block-generator.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npx dotenv-cli -e .env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
